views:
  - type: table
    name: Web Weavers Perks Overview
    filters:
      and:
        - skill == "Web Weavers"
        - type == "perk"
    order:
      - file.name
      - status
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
    columns:
      - field: file.link
        name: Perk Name
        width: 180
      - field: category
        name: Category
        width: 150
      - field: status
        name: Implementation
        width: 120
      - field: tags
        name: Tags
        width: 250
    columnSize:
      file.name: 255
