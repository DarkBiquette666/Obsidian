views:
  - type: table
    name: Life Leech Aura Perks Overview
    filters:
      and:
        - skill == "Life Leech Aura"
        - type == "perk"
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
    columns:
      - field: file.link
        name: Perk Name
        width: 180
      - field: category
        name: Category
        width: 150
      - field: status
        name: Implementation
        width: 120
      - field: tags
        name: Tags
        width: 250
  - type: cards
    name: Perks by Category
    filters:
      and:
        - skill == "Life Leech Aura"
        - type == "perk"
    sort:
      - property: file.name
        direction: ASC
    columns: 3
    group:
      property: category
  - type: list
    name: Implementation Priority
    filters:
      and:
        - skill == "Life Leech Aura"
        - type == "perk"
        - status == "concept"
    sort:
      - property: category
        direction: ASC
