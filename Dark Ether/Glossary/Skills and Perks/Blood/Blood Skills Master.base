views:
  - type: table
    name: All Blood Perks Overview
    filters:
      and:
        - note["skill Family"] == "blood"
    order:
      - file.name
      - status
      - category
    sort:
      - property: skill
        direction: ASC
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
    columns:
      - field: file.link
        name: Perk Name
        width: 200
      - field: skill
        name: Skill
        width: 140
      - field: category
        name: Category
        width: 160
      - field: status
        name: Implementation
        width: 120
      - field: tags
        name: Tags
        width: 300
  - type: cards
    name: Perks by Skill
    sort:
      - property: category
        direction: ASC
      - property: file.name
        direction: ASC
    columns: 4
    group:
      property: skill
  - type: list
    name: Implementation Priority - Not Started
    sort:
      - property: skill
        direction: ASC
      - property: category
        direction: ASC
  - type: list
    name: Implemented Perks
    sort:
      - property: skill
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Perk Statistics
    group:
      property: skill
    columns:
      - field: skill
        name: Skill
        width: 150
      - field: status
        name: Status Count
        width: 400
        aggregate: count
