formulas:
  Untitled: ""
views:
  - type: table
    name: Vital Link Perks Overview
    filters:
      and:
        - skill == "Vital Link"
        - type == "perk"
    order:
      - file.name
      - status
    sort:
      - property: formula.Untitled
        direction: ASC
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
    columns:
      - field: file.link
        name: Perk Name
        width: 180
      - field: category
        name: Category
        width: 150
      - field: status
        name: Implementation
        width: 120
      - field: tags
        name: Tags
        width: 200
  - type: cards
    name: Perks by Status
    filters:
      and:
        - skill == "Vital Link"
        - type == "perk"
    sort:
      - property: category
        direction: ASC
    columns: 3
    group:
      property: status
  - type: list
    name: Implementation Priority
    filters:
      and:
        - skill == "Vital Link"
        - type == "perk"
        - status == "concept"
    sort:
      - property: category
        direction: ASC
